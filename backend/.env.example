# Ambiente: production / development
APP_ENV=development
PORT=8000
# Em produção, informe a URL do banco persistente existente após validação dos dados.
DATABASE_URL=
# Somente desenvolvimento local, se DATABASE_URL estiver vazia.
LOCAL_DB_PATH=./data/duarte_performance_dev.sqlite3
# Segredo aleatório exclusivo, mínimo 32 caracteres. Não publicar no repositório.
SECRET_KEY=SUBSTITUA_POR_SEGREDO_ALEATORIO_LONGO
# Origens web permitidas somente se a interface for hospedada em outro domínio.
CORS_ORIGINS=
# Apenas desenvolvimento limpo e descartável: cria schema a partir dos modelos atuais.
ALLOW_SCHEMA_CREATE=false
# Bootstrap opcional e idempotente. Não substitui senha existente por padrão.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_RESET_EXISTING=false
